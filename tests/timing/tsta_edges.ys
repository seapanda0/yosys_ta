# A path from a rising to a falling edge only has half a period
read_verilog <<EOT
module top(input clk, a, output y);
  wire q, n;
  DFF_X1 f0 (.CK(clk), .D(a), .Q(q));
  INV_X1 g (.A(q), .Y(n));
  DFF_X2 f1 (.CK(clk), .D(n), .Q(y));
endmodule
EOT

# q: 0.210, slew 0.030;  n: +0.033, slew 0.0315;  setup 0.1063 -> 0.3493 in half a period
logger -expect warning "falling clock edge" 1
tsta -liberty "mixed edge.lib" -period 0.5 -load 0
scratchpad -assert timing.result.wns -0.099300
scratchpad -assert timing.result.min_period 0.698600
logger -check-expected
